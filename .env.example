APP_ENV=local
PUBLIC_BASE_URL=http://localhost:8080
# Comma-separated frontend origins allowed by CORS; the first is the OAuth done-redirect base.
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://skywoop:skywoop@localhost:5432/skywoop
DB_AUTH=password
# AZURE_CLIENT_ID=
AUTH_MODE=dev_token
DEV_TOKEN=dev-secret-token-change-me
# AUTH_MODE=jwt
# AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
# AUTH_ISSUER=http://localhost:3000
# AUTH_AUDIENCE=skywoop-api
AZURE_OPENAI_BASE=https://example.openai.azure.com/openai/v1
# AZURE_OPENAI_IMAGES_API_VERSION=
# Optional local Bearer when managed identity is unavailable:
AZURE_OPENAI_API_KEY=
DEPLOYMENT_PLANNER=gpt-5.5
DEPLOYMENT_VISION=gpt-5.5
DEPLOYMENT_COPY=gpt-5.5-mini
DEPLOYMENT_IMAGE_DRAFT=gpt-image-2.5
DEPLOYMENT_IMAGE_FINAL=gpt-image-2.5
IMAGE_RPM=5
LOCAL_ASSET_DIR=./.data/assets
LOCAL_SECRETS_FILE=./.data/secrets.json
# BLOB_ACCOUNT=
# BLOB_CONTAINER=assets
# KEYVAULT_URL=
META_APP_ID=
META_APP_SECRET_NAME=meta-app-secret
META_GRAPH_VERSION=v26.0
META_GRAPH_BASE=https://graph.facebook.com
ASC_ISSUER_ID=
ASC_KEY_ID=
ASC_P8_SECRET_NAME=asc-p8
ASC_BASE=https://api.appstoreconnect.apple.com
LINK_HASH_SECRET_NAME=link-hash-secret
OAUTH_DONE_URL=http://localhost:3000/onboarding/meta/done
LISTEN_ADDR=0.0.0.0:8080
FALLBACK_URL=https://apps.apple.com
