<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title }}</title>
  <style>
    body { font-family: Georgia, serif; margin: 2rem; color: #1a1a1a; background: #f7f5f2; }
    h1 { font-size: 1.5rem; margin-bottom: 1.5rem; }
    ul { list-style: none; padding: 0; display: grid; gap: 0.75rem; max-width: 32rem; }
    li a { display: block; padding: 0.9rem 1.1rem; background: #fff; border-radius: 0.6rem;
           color: inherit; text-decoration: none; box-shadow: 0 1px 2px rgba(0,0,0,.08); }
  </style>
</head>
<body>
  <h1>{{ title }}</h1>
  <ul>
    {% for v in videos %}
    <li><a href="/r/{{ v.token }}">{{ v.title or "Watch & get the app" }}</a></li>
    {% endfor %}
  </ul>
</body>
</html>
